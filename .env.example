# OpenPokerLab Phase 0. Copy to .env only if you need to override defaults.
# No secrets belong in this file.

API_HOST=0.0.0.0
API_PORT=8000

# Leave DATABASE_URL unset. The API then uses <repo>/data/openpokerlab.db
# on Windows, macOS, and Linux. Do not point this at the cloud machine.
# DATABASE_URL=sqlite:///C:/Users/you/OpenPokerLab/data/openpokerlab.db

# Browser defaults used by the Next.js app when these are unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
